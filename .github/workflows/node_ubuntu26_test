# This defines a workflow to build and release a new version of the cedra Node.
# In order to trigger it go to the Actions Tab of the Repo, click "Release Node" and then "Run Workflow".

name: "Release Node ubuntu 26 test"

on:
  workflow_dispatch:
    inputs:
      release_version:
        type: string
        required: true
        description: "The release version. E.g. `0.2.3`:"
      source_git_ref_override:
        type: string
        required: false
        description: "GIT_SHA_OVERRIDE: Use this to override the Git SHA1, branch name (e.g. devnet) or tag to build the binaries from. Defaults to the workflow Git REV, but can be different than that:"
      dry_run:
        type: boolean
        required: false
        default: true
        description: "Dry run - If checked, the release will not be created"


jobs:
  # Add one for 24.04 to be clear
  build-ubuntu26-binary:
    name: "Build Ubuntu 26.04 binary"
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.source_git_ref_override }}
      - uses: cedra-labs/cedra-network/.github/actions/node-rust-setup@main
      - name: Build Node
        run: scripts/node/build_node_release.sh "Ubuntu-26.04" "${{inputs.release_version}}" "false"
      - name: Upload Binary
        uses: actions/upload-artifact@v4
        with:
          name: node-builds-ubuntu-26.04
          path: cedra-node-*.zip

  release-binaries:
    name: "Release binaries"
    needs:
      - build-ubuntu26-binary
    runs-on: ubuntu-latest
    permissions:
      contents: "write"
      pull-requests: "read"
    if: ${{ inputs.dry_run }} == 'false'
    steps:
      - name: Download prebuilt binaries
        uses: actions/download-artifact@v4
        with:
          pattern: node-builds-*
          merge-multiple: true
      - name: Determine release tag
        id: release-tag
        env:
          SOURCE_REF: ${{ inputs.source_git_ref_override || github.ref_name }}
          RELEASE_VERSION: ${{ inputs.release_version }}
        run: |
          tag="cedra-node-v${RELEASE_VERSION}"
          case "${SOURCE_REF}" in
            *-devnet) tag="${tag}-devnet" ;;
            *-testnet) tag="${tag}-testnet" ;;
            *-mainnet) tag="${tag}-mainnet" ;;
          esac
          echo "tag=${tag}" >> "$GITHUB_OUTPUT"
          echo "Using automatic_release_tag=${tag} (source ref: ${SOURCE_REF})"
      - name: Create GitHub Release
        uses: marvinpinto/action-automatic-releases@919008cf3f741b179569b7a6fb4d8860689ab7f0 # pin@v1.2.1
        with:
          repo_token: "${{ secrets.GITHUB_TOKEN }}"
          automatic_release_tag: "${{ steps.release-tag.outputs.tag }}"
          prerelease: false
          title: "${{ format('Cedra Node Release v{0}', inputs.release_version) }}"
          files: |
            cedra-node-*.zip
